{
  "manifest_version": 3,
  "name": "Auto Logon",
  "version": "1.0",
  "description": "Automatically signs in to configured internal sites.",
  "permissions": [
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "*://10.1.1.1/*",
    "*://10.1.1.2/*",
    "*://10.1.1.3/*",
    "*://10.1.1.4/*",
    "*://10.1.1.101/*",
    "*://10.1.1.111/*",
    "*://10.1.1.130/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://10.1.1.1/*",
        "*://10.1.1.2/*",
        "*://10.1.1.3/*",
        "*://10.1.1.4/*",
        "*://10.1.1.101/*",
        "*://10.1.1.111/*",
        "*://10.1.1.130/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}